{
  "name": "qa-agent",
  "version": "0.1.0",
  "description": "Task-driven exploratory QA with reproducible Playwright evidence, safety gates, and minimized findings.",
  "type": "module",
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai-agent",
    "test-generation",
    "e2e",
    "mutation-testing",
    "claude"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "qa-agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dry-run": "tsx scripts/dry-run.mts",
    "evals": "tsx scripts/run-evals.mts evals/login-app.eval.json && tsx scripts/run-evals.mts evals/task-app.eval.json",
    "task-e2e": "node dist/index.js task run --repo fixtures/task-app --file qa-tasks/create-task-evidence.json --json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "ai": "^7.0.15",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
